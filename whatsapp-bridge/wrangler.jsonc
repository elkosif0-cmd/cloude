{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-kosif",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "API_KEY_SHA256": "fca39e71b2c9c76fa3eb88bba863e6e31851234231391e5bd323d3115f1a794a" },
  "containers": [
    {
      "class_name": "WaBridge",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "wa-kosif-files" }],
  "durable_objects": {
    "bindings": [{ "name": "WA", "class_name": "WaBridge" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WaBridge"] }]
}
