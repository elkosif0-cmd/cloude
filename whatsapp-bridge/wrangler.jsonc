{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-kosif",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "WaBridge",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WA", "class_name": "WaBridge" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WaBridge"] }]
}
