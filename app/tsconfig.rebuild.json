{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "types": ["vite/client", "vitest"]
  },
  "include": [
    "src/rebuild/**/*.ts",
    "src/rebuild/**/*.tsx",
    "src/engine/pricingEngine.ts",
    "src/types/**/*.ts",
    "src/storage/localStorage.ts",
    "src/data/seedData.ts"
  ]
}
